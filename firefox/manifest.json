{
  "manifest_version": 2,
  "name": "Tab Crate",
  "version": "1.0.0",
  "description": "Export, save, and restore browser tabs across multiple windows.",
  "permissions": ["tabs", "storage", "downloads", "contextMenus"],
  "browser_action": {
    "default_icon": {
      "16": "4341-frieren-6-1023081867.ico",
      "32": "4341-frieren-6-1023081867.ico"
    },
    "default_title": "Tab Crate",
    "default_popup": "ui/pop-up.html"
  },
  "icons": {
    "16": "4341-frieren-6-1023081867.ico",
    "32": "4341-frieren-6-1023081867.ico",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "ui/pop-up.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open Tab Crate popup"
    },
    "open-tab-crate-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Open Tab Crate in a new tab"
    }
  },
  "background": {
    "page": "background.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-crate@vins.dev",
      "strict_min_version": "109.0"
    }
  }
}
